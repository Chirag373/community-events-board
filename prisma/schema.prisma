generator client {
  provider = "prisma-client"
  output = "../app/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role String @default("USER")
}
model Event {
  id String @id @default(cuid())
  title String
  category String
  city String
  startsAt DateTime
  price Int
  description String
  imageUrl String
  active Boolean @default(true)
  @@index([active, startsAt])
  @@index([active, category, city, startsAt])
}
